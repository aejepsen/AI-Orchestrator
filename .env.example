# Copie para .env e preencha. Nunca commite o .env.

# Token de acesso do boundary público (/chat). Vazio = modo dev (aberto).
ACCESS_TOKEN=

# Chave compartilhada gateway <-> microsserviços. Obrigatória (compose é fail-closed).
# Gere com: openssl rand -base64 24 | tr -d '+/='
INTERNAL_API_KEY=

# Token do Cloudflare Tunnel (só necessário com: docker compose --profile public up -d)
TUNNEL_TOKEN=
