# Copie para .env e preencha. Nunca commite o .env.

# Token de acesso do boundary público (/chat). Vazio = modo dev (aberto).
ACCESS_TOKEN=

# Chave compartilhada gateway <-> microsserviços. Obrigatória (compose é fail-closed).
# Gere com: openssl rand -base64 24 | tr -d '+/='
INTERNAL_API_KEY=

# Token do Cloudflare Tunnel (só necessário com: docker compose --profile public up -d)
TUNNEL_TOKEN=

# Semantic router (Qdrant + embeddings locais via Ollama)
# SEMANTIC_ENABLED=1
# EMBED_MODEL=nomic-embed-text
# SEMANTIC_THRESHOLD=0.92
KEEP_ALIVE=30m

# Langfuse (observabilidade LLM) — UI em http://localhost:3100
# LANGFUSE_ENABLED=1
# SEGURANÇA: pk-lf-local / sk-lf-local são defaults INSEGUROS (apenas dev local).
# Em produção, gere chaves reais no painel do Langfuse e defina aqui.
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
# LANGFUSE_DB_PASSWORD=langfuse-local
# LANGFUSE_NEXTAUTH_SECRET=mysecret-change-in-production
