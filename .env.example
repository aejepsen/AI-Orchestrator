# Copie para .env e preencha. Nunca commite o .env.

# ── Modelo ──────────────────────────────────────────────────────────────
# MODEL=qwen2.5:7b-instruct-q4_K_M
KEEP_ALIVE=30m

# ── Auth ────────────────────────────────────────────────────────────────
# Token de acesso do boundary público (/chat). Vazio + ALLOW_OPEN_ACCESS!=1 = bloqueado (fail-closed).
ACCESS_TOKEN=
# Modo dev aberto: só funciona sem ACCESS_TOKEN. Em produção, NUNCA ativar.
# ALLOW_OPEN_ACCESS=1

# Chave compartilhada gateway <-> microsserviços. Obrigatória (compose é fail-closed).
# Gere com: openssl rand -base64 24 | tr -d '+/='
INTERNAL_API_KEY=

# ── Rate limiting ──────────────────────────────────────────────────────
# RATE_LIMIT_PER_HOUR=10

# ── Timeouts e pool ───────────────────────────────────────────────────
# LLM_TIMEOUT_S=900
# AGENT_DEADLINE_S=600
# REQUEST_TIMEOUT_S=600
# MAX_GRAPH_WORKERS=4

# ── Cloudflare Tunnel (só com: docker compose --profile public up -d) ──
TUNNEL_TOKEN=

# ── Qdrant (banco vetorial do semantic router) ────────────────────────
# Gere com: openssl rand -base64 24 | tr -d '+/='
QDRANT_API_KEY=

# ── Semantic router (Qdrant + SBERT embeddings) ────────────────────────
# SEMANTIC_ENABLED=1
# SEMANTIC_THRESHOLD=0.92
# MIN_SCORE_GAP=0.05

# ── Embeddings (SBERT primário, Ollama fallback) ───────────────────────
# SBERT_MODEL=paraphrase-multilingual-MiniLM-L12-v2  # 384d, similaridade simétrica — melhor para classificação de domínios por nearest-neighbor
# SBERT_MODEL=intfloat/multilingual-e5-large          # 1024d, retrieval assimétrico — testado, piorou roteamento (~51% vs ~57%)
# SBERT_DIM=384
# EMBED_MODEL=nomic-embed-text          # fallback se SBERT indisponível

# ── Injection classifier BERT ─────────────────────────────────────────
# INJECTION_MODEL_PATH=models/injection_classifier
# INJECTION_ENABLED=1

# ── Semiose — Camada A: enriquecimento contextual ────────────────────
# ENRICHER_ENABLED=1
# SPACY_ENABLED=1

# ── Semiose — Camada C: re-ranking contextual no semantic router ──────
# RERANK_ENABLED=1
# CONTEXT_BOOST=0.05
# S3 — cross-encoder reranker (Nível 2, opt-in; usa sentence-transformers)
# RERANK_CROSS_ENCODER_ENABLED=0
# CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# S1 — Contextual Embeddings no índice do router (opt-in; prefixa exemplos c/ domínio)
# CONTEXTUAL_EMBEDDINGS_ENABLED=0

# ── Semiose — Camada B: Knowledge Graph (Neo4j) ─────────────────────
# Só ativa com: docker compose --profile graph up -d
# NEO4J_ENABLED=0
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
# Camada A+B: realimenta o enricher com vizinhos 1-hop do KG na query do
# classificador (opt-in; requer NEO4J_ENABLED=1). Validar em eval antes de ligar.
# KG_ENRICH_ENABLED=0

# ── Langfuse (observabilidade LLM) — UI em http://localhost:3100 ───────
# LANGFUSE_ENABLED=1
# Gere chaves reais no painel do Langfuse após o primeiro boot.
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_DB_PASSWORD=langfuse-local
# Obrigatórios (compose é fail-closed). Gere com: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# ── LangSmith (tracing cloud, ecossistema LangChain) ───────────────────
# Plano gratuito: smith.langchain.com → Settings → API Keys → Create
# LANGSMITH_ENABLED=1
# LANGSMITH_API_KEY=ls__...
# LANGSMITH_PROJECT=ai-orchestrator
# LANGSMITH_OTEL_ENABLED=0   # use OTEL collector em vez de envio direto

# ── OpenTelemetry (padrão CNCF para distributed tracing) ───────────────
# OTEL_ENABLED=0
# OTEL_SERVICE_NAME=ai-orchestrator
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ── Phoenix (LLM evaluation, Arize Apache 2.0) — UI em http://localhost:6006
# Sobe com: docker compose --profile observability up -d
# PHOENIX_ENABLED=1
# PHOENIX_HOST=http://phoenix:6006
# PHOENIX_PROJECT=ai-orchestrator
